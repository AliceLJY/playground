  "subtitles": [
    {
      "at": 0.5,
      "until": 4.6,
      "text": "早上九点，办公室开门了"
    },
    {
      "at": 5,
      "until": 9.5,
      "text": "大家陆续来上工"
    },
    {
      "at": 9.8,
      "until": 11.7,
      "text": "CC 到了，开工"
    },
    {
      "at": 12.5,
      "until": 16.3,
      "text": "忙里偷闲，来一局"
    },
    {
      "at": 18,
      "until": 22.8,
      "text": "Cobbler 从座位送来一张纸条"
    },
    {
      "at": 23.8,
      "until": 30.7,
      "text": "走两步，把活递给 Codex"
    },
    {
      "at": 31,
      "until": 33,
      "text": "收到，这就开工"
    },
    {
      "at": 33.5,
      "until": 35.4,
      "text": "交活了，撒一把彩纸"
    },
    {
      "at": 35.6,
      "until": 40.8,
      "text": "交了大活，请大家吃点心"
    },
    {
      "at": 41,
      "until": 43.5,
      "text": "客人来了，大家挥手打招呼"
    },
    {
      "at": 43.6,
      "until": 45.8,
      "text": "还拎来了奶茶"
    },
    {
      "at": 46,
      "until": 48,
      "text": "谢谢！一人一杯"
    },
    {
      "at": 48.2,
      "until": 53.0,
      "text": "有人带项目来谈事"
    },
    {
      "at": 53.1,
      "until": 56.8,
      "text": "聊好了，握个手，下次见"
    },
    {
      "at": 57.2,
      "until": 62.8,
      "text": "豆包带回今天的选题"
    },
    {
      "at": 63.2,
      "until": 68.8,
      "text": "Grok Bot 从云上回来了"
    },
    {
      "at": 69.2,
      "until": 72.4,
      "text": "撞额度了，先罚站"
    },
    {
      "at": 73,
      "until": 75.8,
      "text": "走，下楼一起看看初稿"
    },
    {
      "at": 76,
      "until": 77.5,
      "text": "这一轮吵起来了"
    },
    {
      "at": 77.5,
      "until": 78.7,
      "text": "大家围过来吃瓜"
    },
    {
      "at": 78.7,
      "until": 81,
      "text": "这一轮，吵得有点冒烟"
    },
    {
      "at": 81,
      "until": 82.5,
      "text": "哼！先各退一步"
    },
    {
      "at": 82.5,
      "until": 84.5,
      "text": "再看一轮，继续对证据"
    },
    {
      "at": 84.6,
      "until": 86.8,
      "text": "客人坐旁边，也听得入神"
    },
    {
      "at": 87,
      "until": 89.5,
      "text": "有了主意，回楼上接着干"
    },
    {
      "at": 89.6,
      "until": 90.8,
      "text": "来过的人，做过的事，都记着"
    },
    {
      "at": 91,
      "until": 94,
      "text": "夜宵来了"
    },
    {
      "at": 94.5,
      "until": 100.8,
      "text": "夜深了，保安打着手电巡一圈"
    },
    {
      "at": 102,
      "until": 103.8,
      "text": "门口亮起绿灯，放心啦"
    },
    {
      "at": 104,
      "until": 105.8,
      "text": "明天见"
    },
    {
      "at": 106,
      "until": 107.5,
      "text": "关灯"
    }
  ],
